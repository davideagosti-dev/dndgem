{
  "name": "@dndgem/svelte",
  "version": "0.1.0-alpha.4",
  "description": "Svelte adapter for DnDGem — thin lifecycle and registration over @dndgem/dom.",
  "author": "DA62",
  "license": "MIT",
  "homepage": "https://dndgem.dev",
  "bugs": {
    "url": "https://dndgem.dev/support/",
    "email": "support@dndgem.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideagosti-dev/dndgem.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "dndgem",
    "da62",
    "layout",
    "svelte",
    "drag-and-drop",
    "actions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.server.js",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/compile-provider.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run --project jsdom && vitest run --project ssr"
  },
  "dependencies": {
    "@dndgem/core": "workspace:*",
    "@dndgem/dom": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
