{
  "name": "@dndgem/intelligence-openai",
  "version": "0.0.0",
  "private": true,
  "description": "Private OpenAI reference LayoutPlanner for the DND-4.4 model-assisted planning experiment. Server-oriented BYOK. Not published.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src experiment --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "experiment": "node --import tsx experiment/run.ts"
  },
  "dependencies": {
    "@dndgem/intelligence": "workspace:*",
    "openai": "^6.15.0"
  },
  "devDependencies": {
    "@dndgem/core": "workspace:*",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
