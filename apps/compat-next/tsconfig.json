{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["app", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
