{
  "name": "@dndgem/compat-sveltekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5183",
    "build": "svelte-kit sync && vite build",
    "start": "node ./start-server.mjs",
    "start:e2e": "svelte-kit sync && vite build && node ./start-server.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dndgem/svelte": "workspace:*",
    "svelte": "^5.38.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.26.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
